# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no
# painel da Vercel (Settings → Environment Variables) para produção.
# Nunca faça commit do .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave secreta (service_role). Usada SOMENTE no servidor para o treinador
# cadastrar alunos. Não use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Notificações push (Web Push). Gere o par com: npx web-push generate-vapid-keys
# A chave pública é entregue ao aparelho pelo servidor; a privada fica só aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo app (exigido pelos serviços de push).
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Segredo do cron diário da Vercel (/api/cron/billing): lembretes de
# mensalidade e push pendente. Use um texto longo e aleatório.
CRON_SECRET=

# GIFs dos exercícios (biblioteca do treinador e treino do aluno).
# Vazio: usa a CDN do repositório público do dataset (jsDelivr). Defina um
# endereço próprio (http/https, sem barra no fim) se copiar os GIFs para o seu
# armazenamento, ou "off" para desligar os GIFs. Crédito obrigatório:
# © Gym visual — https://gymvisual.com/ (o app mostra junto de cada GIF).
# NEXT_PUBLIC_EXERCISE_MEDIA_BASE_URL=
