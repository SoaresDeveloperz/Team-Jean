# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no
# painel da Vercel (Settings → Environment Variables) para produção.
# Nunca faça commit do .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave secreta (service_role). Usada SOMENTE no servidor para o treinador
# cadastrar alunos. Não use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
